# =============================================================================
# БЛОК НАСТРОЙКИ ТОЧКИ ВХОДА И ИНТЕРПРЕТАТОРА
# Определяет, какой файл запускается при старте проекта и какие модули
# (языки/версии) подключены.
# =============================================================================
entrypoint = "main.py"          # Главный скрипт, который выполняется при запуске
modules = ["python-3.11"]       # Используемый язык и его версия (Python 3.11)

# =============================================================================
# БЛОК УПРАВЛЕНИЯ ЗАВИСИМОСТЯМИ ЧЕРЕЗ NIX (ПАКЕТНЫЙ МЕНЕДЖЕР REPLIT)
# Пакеты, перечисленные здесь, устанавливаются в окружение через Nix.
# Они не зависят от pip и доступны на уровне системы.
# =============================================================================
[nix]
channel = "stable-25_05"        # Канал Nix (стабильный релиз от мая 2025 года)
packages = [                    # Список системных пакетов, необходимых проекту:
    "cairo",                    # Графическая библиотека (используется matplotlib, seaborn)
    "ffmpeg-full",              # Для обработки видео/изображений (может требоваться некоторыми бэкендами)
    "freetype",                 # Рендеринг шрифтов (matplotlib)
    "ghostscript",              # Работа с PostScript/PDF (matplotlib)
    "glibcLocales",             # Локали (нужны для корректного вывода текста)
    "gobject-introspection",    # Связывание графических библиотек с Python (pygobject)
    "gtk3",                     # GTK+3 – для GUI-бэкендов (хотя мы используем Agg, но seaborn/matplotlib могут требовать)
    "pkg-config",               # Утилита для поиска библиотек при компиляции
    "qhull",                    # Алгоритмы построения выпуклых оболочек (используется в некоторых визуализациях)
    "tcl", "tk"                 # Tcl/Tk – для встроенного tkinter-бэкенда matplotlib
]

# =============================================================================
# БЛОК НАСТРОЙКИ ЮНИТ-ТЕСТИРОВАНИЯ
# Определяет язык для тестов (в данном проекте тесты отсутствуют, секция оставлена по умолчанию)
# =============================================================================
[unitTest]
language = "python3"

# =============================================================================
# БЛОК НАСТРОЙКИ ИМПОРТА С GITHUB
# Указывает, какие файлы необходимы для клонирования репозитория
# =============================================================================
[gitHubImport]
requiredFiles = [".replit", "replit.nix"]   # Ожидается наличие обоих конфигов (replit.nix – опционально)

# =============================================================================
# БЛОК КОНФИГУРАЦИИ РАЗВЁРТЫВАНИЯ (DEPLOYMENT)
# Определяет, как запускать приложение при деплое на Cloud Run (серверный рантайм)
# =============================================================================
[deployment]
run = ["python3", "main.py"]        # Команда запуска (используется Python 3 и скрипт main.py)
deploymentTarget = "cloudrun"       # Целевая платформа – Cloud Run (контейнеризованное выполнение)

# =============================================================================
# БЛОК НАСТРОЙКИ ПОМОЩНИКА (AGENT)
# expertMode – включает расширенные возможности (например, прямой доступ к терминалу)
# =============================================================================
[agent]
expertMode = true

# =============================================================================
# БЛОК КОНФИГУРАЦИИ WORKFLOW (АВТОМАТИЗАЦИЯ ЗАПУСКА)
# Определяет действия, выполняемые при нажатии кнопки "Run" в интерфейсе Replit.
# Используется параллельный режим (parallel) для запуска основного приложения.
# =============================================================================
[workflows]
runButton = "Project"                           # Название кнопки запуска

[[workflows.workflow]]
name = "Project"                                # Имя основного workflow
mode = "parallel"                               # Запуск задач параллельно (в данном случае одна задача)
author = "agent"                                # Автор (системный)

[[workflows.workflow.tasks]]
task = "workflow.run"                           # Тип задачи: запуск другого workflow
args = "Start application"                      # Имя вызываемого workflow

[[workflows.workflow]]
name = "Start application"                      # Workflow, который реально выполняет команду
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"                             # Тип задачи: выполнение команды в shell
args = "python3 main.py"                        # Команда запуска нашего микросервиса

[workflows.workflow.metadata]
outputType = "console"                          # Вывод направляется в консоль (видна в IDE Replit)
